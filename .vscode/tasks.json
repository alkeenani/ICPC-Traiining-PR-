{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C++: Run Current File",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/run.sh", "${file}"],
      "windows": {
        "command": "cmd.exe",
        "args": ["/d", "/c", "${workspaceFolder}\\scripts\\run.bat", "${file}"]
      },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "clear": true },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "C++: Build (Debug)",
      "type": "process",
      "command": "clang++",
      "args": [
        "-std=c++17",
        "-g",
        "${file}",
        "-o",
        "${workspaceFolder}/build/${fileBasenameNoExtension}"
      ],
      "windows": {
        "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
        "args": [
          "-std=c++17",
          "-g",
          "${file}",
          "-o",
          "${workspaceFolder}\\build\\${fileBasenameNoExtension}.exe"
        ]
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}
